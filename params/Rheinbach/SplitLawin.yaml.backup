experiment:
  continue_with_errors: true
  entity: null
  excluded_files: '*.pth'
  group: SplitLawin
  name: weedmapping-rededge
  start_from_grid: 0
  start_from_run: 0
  tracking_dir: null
other_grids: null
parameters:
  dataset:
    batch_size:
    - 6
    channels:
    - - R
      - G
      - B
      - NIR
    - - R
      - G
      - B
      - NDVI
    - - R
      - G
      - B
      - RE
    - - R
      - G
      - B
      - NIR
      - RE
    crop_size:
    - same
    hor_flip:
    - true
    num_classes:
    - 3
    num_workers:
    - 0
    return_path:
    - true
    root:
    - dataset/0_rotations_processed_003_test/RedEdge
    size:
    - same
    test_batch_size:
    - 12
    test_folders:
    - - '003'
    train_folders:
    - - '000'
      - '001'
      - '002'
      - '004'
    val_batch_size:
    - 12
    ver_flip:
    - true
  dataset_interface:
  - wd/data/WeedMapDatasetInterface
  early_stopping:
    mode:
    - min
    monitor:
    - loss
    patience:
    - 10
  model:
    name:
    - wd/models/splitlawin
    params:
      backbone:
      - MiT-B0
      - MiT-B1
      backbone_pretrained:
      - true
      fusion_type:
      - conv_sum
      - conv_sum_drop
      - squeeze_excite
      main_channels:
      - 3
      side_pretrained:
      - G
  phases:
  - - train
    - test
  tags:
  - []
  test_callbacks:
    PerExampleMetricCallback:
      phase:
      - TEST_BATCH_END
    SegmentationVisualizationCallback: null
  test_metrics:
    auc: &id001
      num_classes:
      - 3
    conf_mat: *id001
    f1: *id001
    jaccard: *id001
    perclassauc:
      discriminator:
      - - - auc_background
          - 0
        - - auc_crop
          - 1
        - - auc_weed
          - 2
    precision: *id001
    recall: *id001
  train_metrics:
    f1: *id001
  train_params:
    average_best_models:
    - false
    freeze_pretrained:
    - true
    - false
    greater_metric_to_watch_is_better:
    - false
    initial_lr:
    - 0.0001
    loss:
      name:
      - focal
      params:
        gamma:
        - 2.0
        weight:
        - - 0.0638
          - 1.0
          - 1.6817
    max_epochs:
    - 500
    metric_to_watch:
    - loss
    optimizer:
    - Adam
    optimizer_params:
      weight_decay:
      - 0
    seed:
    - 42

    zero_weight_decay_on_bias_and_bn:
    - true
  val_callbacks:
    SegmentationVisualizationCallback:
      batch_idxs:
      - - 4
        - 16

